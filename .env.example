# Copy to .env and fill in. .env is gitignored.

# --- Telnyx -------------------------------------------------------------------
TELNYX_API_KEY=
# Account Settings > Keys & Credentials > Public Key (base64, 32 bytes)
TELNYX_PUBLIC_KEY=
TELNYX_NUMBER=+1...

# The public wss:// URL Telnyx will stream audio to. Must be reachable from the
# internet -- Telnyx cannot dial your laptop. Use an ngrok tunnel for local dev.
# Include STREAM_SECRET in it (see below): wss://your-host/telnyx/stream/<secret>
PUBLIC_STREAM_URL=wss://your-host/telnyx/stream

# Secret guarding the media WebSocket. Telnyx does not sign stream frames, so this
# secret in the URL is what stops a stranger opening a (Gemini-billed) session or
# spoofing a caller. Leave blank ONLY for local dev on a non-public host.
# Any long random string; must also appear in PUBLIC_STREAM_URL above.
STREAM_SECRET=

# --- AI provider --------------------------------------------------------------
# ai_studio is for DEVELOPMENT WITH SYNTHETIC DATA ONLY. It is not BAA-eligible.
# Switch to vertex and execute a Google Cloud BAA before any real patient calls.
AI_PROVIDER=ai_studio
GEMINI_API_KEY=
# Only needed when AI_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Voice reply latency (turn-taking) ----------------------------------------
# How fast the agent replies after the caller stops talking. Defaults are snappy;
# a noisy clinic that finds callers being clipped can dial patience back up here.
#   VAD_SILENCE_MS         silence after speech before the agent takes its turn (default 400)
#   VAD_END_SENSITIVITY    high = end the turn sooner (default), low = wait to be sure
#   VAD_PREFIX_PADDING_MS  audio kept before detected speech start (default 100)
#   VAD_START_SENSITIVITY  high = pick up speech eagerly (default)
# Affective dialog reads the caller's tone but costs a little latency; set false to trade it away.
VAD_SILENCE_MS=400
VAD_END_SENSITIVITY=high
AI_ENABLE_AFFECTIVE_DIALOG=true

# Voice + model. GEMINI_VOICE picks the prebuilt voice; soothing/lively female options:
# Aoede (breezy, default here), Leda (youthful), Callirrhoe (easy-going), Autonoe (bright).
# GEMINI_LIVE_MODEL swaps the model: blank = native-audio (most human), or
# gemini-3.1-flash-live-preview (faster to reply, plainer/robotic voice). Switching to
# the faster model is safe: the app auto-drops the native-audio-only features (affective
# dialog, thinking, non-blocking tool calls) that model would otherwise reject.
GEMINI_VOICE=Aoede
GEMINI_LIVE_MODEL=

# Second agent: the trailer-rental agent is wired only when this config file exists.
# It gets its own distinct voice so callers can tell the two agents apart.
TRAILER_CONFIG=trailer_config.yaml
TRAILER_GEMINI_VOICE=Puck

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://clinic:clinic@localhost:55432/clinic

# Signs the slot tokens that make an invented appointment time unbookable.
# Any long random string; rotating it just invalidates offers mid-call.
SLOT_TOKEN_SECRET=

# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
PORT=8080

# Operator console (leave blank to disable it entirely). Sets the login for /login; the
# console (calls, appointments, reminders, SMS inbox) lives under /dashboard.
# DASHBOARD_USERNAME is optional: set it and the login page requires a username too;
# leave it blank for password-only login. TELNYX_NUMBER must be set for the inbox to send.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Staff schedule access over the phone (optional). Set a PIN and the agent will read out
# a day's booked appointments to any caller who can quote it. Leave blank to disable the
# feature entirely -- the schedule is patient PII and is never readable without the PIN.
STAFF_PIN=

# Google Calendar mirror (optional). Share the clinic calendar with the service
# account email, then set the calendar id and either inline JSON or a path to the key.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
